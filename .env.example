# Copie com npm run setup. Mantenha chaves reais apenas no .env.
# Groq faz a transcrição; OpenRouter executa o Jev. Fireworks é uma alternativa opcional.
TRANSCRIPTION_PROVIDER=groq
APIFY_TOKEN=
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=google/gemini-3.1-flash-lite
FIREWORKS_API_KEY=
GROQ_API_KEY=
PORT=5190

# Limites locais de ritmo. Reduza-os conforme a cota real da sua conta.
FIREWORKS_REQUESTS_PER_MINUTE=60
GROQ_REQUESTS_PER_MINUTE=20
